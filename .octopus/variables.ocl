variable "Project.App.Service.Plan.Name" {
    value "octopetshop-asp" {}
}

variable "Project.Azure.Runtime" {
    value "dotnet:6" {}
}

variable "Octopus.Azure.Account" {
    type = "AzureAccount"

    value "azure-service-principle-account" {
        description = ""
    }
}

variable "Project.Worker.Pool.Name" {
    type = "WorkerPool"

    value "azure-worker-pool" {}
}

variable "Octopus.ServiceNow.ChangeRequest.Number" {
    value {}
}

variable "Project.Notes.Field" {
    value "This is a test entry..." {}
}

variable "Workers-AM-PROD" {
    type = "WorkerPool"

    value "workers-aws" {
        environment = ["production"]
    }
}